    res.status(201).json({
      success: true,
      message: 'Đăng ký thành công',
      data: {
        email,
        name,
        token: 'your-jwt-token-here'
      }
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: 'Lỗi đăng ký',
      error: error.message
    });
  }
});

