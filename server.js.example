app.get('/api/showtimes/:id', (req, res) => {
  // TODO: Get showtime details
  const { id } = req.params;
  res.status(200).json({
    success: true,
    data: {
      id,
      movieId: 1,
      cinemaId: 1,
      cinemaName: 'Cinema Quantum',
      date: '2026-03-24',
      time: '14:00',
      format: 'IMAX 2D'
    }
  });
});

app.get('/api/showtimes/:id/seats', (req, res) => {
  // TODO: Get seat map from database
  // Calculate: AVAILABLE, BOOKED, HELD status
  const { id } = req.params;

  // Mock seat data
  const seats = [];
  const rows = ['A', 'B', 'C', 'D', 'E'];
  const cols = 10;

  for (let rowIdx = 0; rowIdx < rows.length; rowIdx++) {
    for (let col = 1; col <= cols; col++) {
      const isBooked = Math.random() > 0.7;
      seats.push({
        id: `${rows[rowIdx]}${col}`,
        row: rows[rowIdx],
        number: col,
        status: isBooked ? 'BOOKED' : 'AVAILABLE'
      });
    }
  }

  res.status(200).json({
    success: true,
    data: seats
  });
});

// ============================================
// ROUTES - BOOKINGS
// ============================================

app.post('/api/bookings/hold', (req, res) => {
  // TODO: Hold a seat for 5 minutes
  const { showtimeId, seatId } = req.body;

  res.status(200).json({
    success: true,
    message: 'Ghế đã được giữ trong 5 phút',
    data: {
      showtimeId,
      seatId,
      expiresAt: new Date(Date.now() + 5 * 60 * 1000)
    }
  });
});

app.post('/api/bookings/checkout', (req, res) => {
  // TODO: Process booking and payment
  // - Verify seats still available
  // - Create bill with transaction
  // - Generate QR code
  // - Send email
  const { showtimeId, seatIds, paymentMethod } = req.body;

  res.status(200).json({
    success: true,
    message: 'Đặt vé thành công',
    data: {
      orderId: 'ORD-' + Date.now(),
      showtimeId,
      seatIds,
      totalPrice: seatIds.length * 100000,
      paymentMethod,
      qrCode: 'https://via.placeholder.com/200x200?text=QR'
    }
  });
});

// ============================================
// ERROR HANDLING
// ============================================

app.use((req, res) => {
  res.status(404).json({
    success: false,
    message: 'Route not found'
  });
});

// ============================================
// START SERVER
// ============================================

app.listen(PORT, () => {
  console.log(`
